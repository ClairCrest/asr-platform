# --- Postgres ---
POSTGRES_USER=asr
POSTGRES_PASSWORD=asr
POSTGRES_DB=asr
DATABASE_URL=postgres://asr:asr@localhost:5432/asr?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=asr-audio
S3_USE_SSL=false
# Optional, defaults to S3_ENDPOINT. Set this only when presigned URLs
# need a different host than the API uses internally to reach MinIO —
# e.g. behind an Ingress, where the API talks to MinIO over the cluster
# network but a browser can only reach it through the Ingress host.
# S3_PUBLIC_ENDPOINT=localhost:9000

# --- API (Go) ---
API_PORT=8080
METRICS_PORT=9090
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Worker (Python) ---
WORKER_MODEL=small.en
WORKER_CONCURRENCY=1
WORKER_METRICS_PORT=9091

# --- Web (dashboard) ---
VITE_API_URL=http://localhost:8080
